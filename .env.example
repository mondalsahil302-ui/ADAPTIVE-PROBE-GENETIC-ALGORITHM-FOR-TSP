# ==============================================================
# Adaptive Evolution Research Console - Environment Configuration
# Copy this file to .env for local overrides (never commit .env to Git)
# ==============================================================

# Server Network Settings
PORT=8000
HOST=0.0.0.0
DEBUG=false

# LKH Optimization Controls
LKH_ENABLED=true
LKH_CADENCE=15
LKH_MIN_GENERATION_GAP=15
LKH_TRIGGER_STAGNATION=9999
LKH_MAX_CALLS_PER_RUN=20
LKH_MAX_SECONDS_PER_CALL=5.0
LKH_MAX_TRIALS=50
LKH_RUNS=1
LKH_CACHE_ENABLED=true

# Storage Directories (Defaults to ./data/runs and ./data/uploads)
# DATA_DIR=./data
# RUNS_DIR=./data/runs
# UPLOADS_DIR=./data/uploads

# Deployment Webhook (Used by CI/CD - set in GitHub Repository Secrets)
# RENDER_DEPLOY_HOOK_URL=https://api.render.com/deploy/srv-xxxxxx?key=yyyyyy

